# Backend API base URL (MUST include the /api prefix)
# Example local: http://localhost:8000/api
# Example production: https://resupilot-ai-backend.onrender.com/api
VITE_API_URL=http://localhost:8000/api

# Google OAuth Client ID for Google Sign-in
VITE_GOOGLE_CLIENT_ID=

# Application Name displayed in UI/title
VITE_APP_NAME=ResuPilot AI

# Environment: "development" or "production"
VITE_ENVIRONMENT=development
