# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/resume_rag

# Security & Authentication
# In production, JWT_SECRET must be at least 32 characters long
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider Configuration
# Supported providers: "openrouter" or "ollama"
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Ollama (Local AI fallback/option)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Vector Search (Qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# CORS & Server Environment
# Comma-separated list of allowed frontend origins (e.g., http://localhost:5173,https://your-frontend.onrender.com)
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
DEBUG=true

# File Upload Settings
UPLOAD_DIR=uploads/tmp
MAX_FILE_SIZE=5242880

# Jobs API (RapidAPI / JSearch)
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# Faster-Whisper Voice Transcription
# Recommended: set FEATURE_VOICE_INTERVIEW=false on memory-constrained (512MB) starter instances.
# Faster-Whisper + fastembed requires at least 1GB - 2GB RAM.
FEATURE_VOICE_INTERVIEW=false
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=float32
